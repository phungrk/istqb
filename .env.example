# Every integration is optional. Leave a group empty and that part runs in demo mode.

# Pass mark shown across the app (percent)
NEXT_PUBLIC_PASS_MARK=65
# Public URL, used for Stripe redirect URLs
APP_URL=http://localhost:3000

# ── Sign-in ──
# Required in production: signs the session cookie (and Google sign-in). npx auth secret
AUTH_SECRET=
# Generated username/password accounts: user001 … user100
GENERATED_ACCOUNT_LIMIT=100
# Optional: also offer "Continue with Google"
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only accounts on this domain may sign in. Empty = any Google account.
ALLOWED_EMAIL_DOMAIN=gmail.com

# ── Storage: Cloudflare R2 (recommended) or Postgres. Without either: .data/demo-db.json (local only) ──
# Cloudflare R2: bucket + an R2 API token with Object Read & Write on that bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Postgres via Prisma instead of R2 (takes priority when set)
DATABASE_URL=

# ── Pricing + AI coach: hidden. Set ENABLE_PRO=1 to bring back the Pricing page, Pro plan and AI coach ──
ENABLE_PRO=

# ── Payments (Stripe Checkout, only with ENABLE_PRO=1). Without these: the demo card form upgrades instantly ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=   # $5 / month recurring price id
STRIPE_PRICE_YEARLY=    # $39 / year recurring price id

# ── AI coach (Claude, only with ENABLE_PRO=1). Without it: canned answers and bank questions ──
ANTHROPIC_API_KEY=
